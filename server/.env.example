# Copy to .env and fill in. Never commit the real .env.

# Get a key at https://aistudio.google.com/apikey (Google AI Studio).
GEMINI_API_KEY=

# Origin of the static frontend (the server.ps1 / any static server you use).
FRONTEND_ORIGIN=http://localhost:8080

# Port the AI chat backend listens on.
PORT=8787
